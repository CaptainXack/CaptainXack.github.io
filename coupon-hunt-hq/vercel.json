{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "rm -rf dist && mkdir dist && cp index.html dist/index.html && cp manifest.webmanifest dist/manifest.webmanifest && cp sw.js dist/sw.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/manifest.webmanifest","headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ]
}